# Writability — npm configuration
#
# Native modules (better-sqlite3) are rebuilt against Electron's ABI by the
# postinstall hook (electron-builder install-app-deps). That auto-detects the
# installed Electron version, so we intentionally do NOT pin a global
# "runtime=electron" / "target=" here — that path is more fragile across
# Electron upgrades.
fund=false
audit=false
